---
import { Info } from '@lucide/astro';
import Container from '../../components/ui/Container.astro';
import PackageDepartures from '../../components/packages/PackageDepartures.astro';
import PackageFacts from '../../components/packages/PackageFacts.astro';
import PackageFaq from '../../components/packages/PackageFaq.astro';
import PackageGallery from '../../components/packages/PackageGallery.astro';
import PackageHero from '../../components/packages/PackageHero.astro';
import PackageItinerary from '../../components/packages/PackageItinerary.astro';
import PackageMobileBar from '../../components/packages/PackageMobileBar.astro';
import PackageRelated from '../../components/packages/PackageRelated.astro';
import PackageServices from '../../components/packages/PackageServices.astro';
import PackageSidebar from '../../components/packages/PackageSidebar.astro';
import { site } from '../../config/site.js';
import { getAllPackages, getRelatedPackages } from '../../data/packages.js';
import MainLayout from '../../layouts/MainLayout.astro';

export function getStaticPaths() {
  return getAllPackages()
    .filter((pkg) => pkg.slug !== 'proximamente')
    .map((pkg) => ({
      params: { slug: pkg.slug },
      props: { pkg },
    }));
}

const { pkg } = Astro.props;
const related = getRelatedPackages(pkg.slug)
  .filter((item) => item.slug !== 'proximamente')
  .slice(0, 3);
// La caja solo se muestra si le sirve al viajero, no si únicamente avisa que el contenido es de ejemplo.
const hasUsefulInfo =
  typeof pkg.importantInfo === 'string' &&
  pkg.importantInfo.trim().length > 0 &&
  !/\b(de ejemplo|demo|ilustrativ)/i.test(pkg.importantInfo);
const sectionTitle = 'font-display text-3xl leading-tight font-bold text-violet-dark md:text-4xl';
const touristTrip = {
  '@context': 'https://schema.org',
  '@type': 'TouristTrip',
  name: pkg.title,
  description: pkg.description,
  url: new URL(`/paquetes/${pkg.slug}`, site.url).href,
  image: new URL(pkg.image.src, site.url).href,
  itinerary: {
    '@type': 'ItemList',
    numberOfItems: pkg.itinerary.length,
    itemListElement: pkg.itinerary.map((stop) => ({
      '@type': 'ListItem',
      position: stop.day,
      name: stop.title,
      description: stop.description,
    })),
  },
  provider: {
    '@type': 'TravelAgency',
    name: site.name,
    url: site.url,
  },
};
---

<MainLayout
  title={pkg.title}
  description={pkg.shortDescription}
  image={pkg.image.src}
  jsonLd={site.isDemo ? undefined : touristTrip}
>
  <article>
    <PackageHero pkg={pkg} />
    <PackageFacts pkg={pkg} />

    <Container class="pt-12 pb-18 lg:pt-16 lg:pb-28">
      <div class="lg:grid lg:grid-cols-3 lg:items-start lg:gap-10">
        <div class="space-y-16 lg:col-span-2 lg:space-y-24">
          <section aria-labelledby="sobre-viaje-titulo">
            <h2 id="sobre-viaje-titulo" class={sectionTitle}>Sobre este viaje</h2>
            <p class="mt-4 max-w-3xl">{pkg.description}</p>
          </section>

          {
            pkg.destinations.length > 0 && (
              <section aria-labelledby="destinos-titulo">
                <h2 id="destinos-titulo" class={sectionTitle}>
                  Destinos
                </h2>
                <ul class="mt-6 flex flex-wrap gap-3">
                  {pkg.destinations.map((destination) => (
                    <li class="rounded-pill bg-lilac-soft px-4 py-2 text-lg font-semibold text-violet-dark">
                      {destination}
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <PackageDepartures departures={pkg.departures} />
          <PackageItinerary itinerary={pkg.itinerary} />
          <PackageServices included={pkg.included} excluded={pkg.excluded} />
          <PackageGallery gallery={pkg.gallery} />

          {
            hasUsefulInfo && (
              <section
                class="rounded-card-lg bg-lilac-soft px-5 py-6 md:px-8 md:py-8"
                aria-labelledby="info-importante-titulo"
              >
                <div class="flex items-start gap-4">
                  <Info size={32} aria-hidden="true" class="size-8 shrink-0 text-violet" />
                  <div>
                    <h2 id="info-importante-titulo" class="font-display text-2xl leading-tight font-bold text-violet-dark md:text-3xl">
                      Información importante
                    </h2>
                    <p class="mt-3">{pkg.importantInfo}</p>
                  </div>
                </div>
              </section>
            )
          }

          <PackageFaq faq={pkg.faq} />
        </div>

        <PackageSidebar pkg={pkg} />
      </div>
    </Container>

    <PackageRelated packages={related} />
  </article>
  <PackageMobileBar pkg={pkg} />
</MainLayout>

<style is:global>
  @media (max-width: 63.999rem) {
    body {
      padding-bottom: 6rem;
    }
  }
</style>
