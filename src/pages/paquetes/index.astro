---
import { Image } from 'astro:assets';
import praga from '../../assets/images/hero/hero-praga.jpg';
import Button from '../../components/ui/Button.astro';
import Container from '../../components/ui/Container.astro';
import PackageCard from '../../components/packages/PackageCard.astro';
import { getAllPackages } from '../../data/packages.js';
import { getGeneralWhatsAppLink } from '../../lib/whatsapp.js';
import MainLayout from '../../layouts/MainLayout.astro';

function rank(pkg) {
  if (pkg.status === 'proximamente') return 2;
  if (pkg.featured) return 0;
  return 1;
}

const packages = getAllPackages()
  .slice()
  .sort((a, b) => rank(a) - rank(b));

const description =
  'Salidas acompañadas y viajes internacionales organizados desde Trelew por Molinari Viajes.';
---

<MainLayout title="Nuestros paquetes" description={description}>
  <section class="relative isolate h-[320px] overflow-hidden bg-violet-dark" aria-labelledby="paquetes-titulo">
    <Image
      src={praga}
      alt="Vista de Praga con sus puentes sobre el río Moldava, entre árboles y tejados."
      priority
      width={1920}
      height={Math.round((1920 * praga.height) / praga.width)}
      widths={[640, 960, 1280, 1600, 1920]}
      sizes="100vw"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-[50%_65%]"
    />
    <div class="absolute inset-0 -z-10 bg-violet-dark/75" aria-hidden="true"></div>
    <Container class="flex h-full flex-col justify-end pb-10 lg:pb-12">
      <nav aria-label="Migas de pan">
        <ol class="flex flex-wrap items-center gap-x-2 text-base text-white">
          <li>
            <a
              href="/"
              class="inline-flex min-h-12 min-w-12 items-center font-semibold no-underline underline-offset-4 hover:underline focus-visible:outline-white"
            >
              Inicio
            </a>
          </li>
          <li aria-hidden="true" class="text-lilac-soft">/</li>
          <li class="font-semibold" aria-current="page">Paquetes</li>
        </ol>
      </nav>
      <h1
        id="paquetes-titulo"
        class="mt-1 font-display text-[2.25rem] leading-[1.08] font-extrabold tracking-[-0.02em] text-white md:text-[2.75rem] lg:text-[3.5rem]"
      >
        Nuestros paquetes
      </h1>
      <p class="mt-3 max-w-3xl text-lg text-white">
        Salidas acompañadas y viajes internacionales organizados desde Trelew.
      </p>
    </Container>
  </section>

  <section class="pt-12 pb-18 lg:pt-16 lg:pb-28" aria-labelledby="listado-paquetes-titulo">
    <Container>
      <h2 id="listado-paquetes-titulo" class="sr-only">Listado de paquetes</h2>
      <ul class="grid grid-cols-1 items-stretch gap-7 md:grid-cols-2 md:gap-8 lg:grid-cols-3">
        {
          packages.map((pkg) => (
            <li class="h-full">
              <PackageCard pkg={pkg} variant="horizontal" />
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <section class="pb-18 lg:pb-28" aria-labelledby="propuesta-titulo">
    <Container>
      <div class="rounded-card-lg bg-lilac-soft px-6 py-10 text-center md:px-10 md:py-12">
        <h2
          id="propuesta-titulo"
          class="font-display text-3xl leading-tight font-extrabold text-balance text-violet-dark md:text-4xl"
        >
          ¿No encontrás el viaje que buscás?
        </h2>
        <p class="mx-auto mt-4 max-w-2xl">
          Contanos a dónde querés ir y armamos una propuesta a tu medida.
        </p>
        <div class="mt-6 flex justify-center">
          <Button
            href={getGeneralWhatsAppLink()}
            variant="whatsapp"
            size="large"
            class="w-full lg:w-auto"
          >
            Consultanos por WhatsApp
          </Button>
        </div>
      </div>
    </Container>
  </section>
</MainLayout>
