---
import { Calendar, CalendarSearch, Clock, MapPin, Route } from '@lucide/astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import { getPackageWhatsAppLink } from '../../lib/whatsapp.js';

const { pkg } = Astro.props;
const destinationCount = Array.isArray(pkg.destinations) ? pkg.destinations.length : 0;
const isPending = (value) => !value || value === 'A confirmar';
const datesPending = isPending(pkg.departureDate) && isPending(pkg.duration);

const modality = isPending(pkg.modality)
  ? []
  : [{ label: 'Modalidad', value: pkg.modality, icon: Route }];

const facts = datesPending
  ? [
      ...modality,
      { label: 'Destinos', value: String(destinationCount), icon: MapPin },
      { label: 'Fechas', value: 'Consultá disponibilidad', icon: CalendarSearch, wide: true },
    ]
  : [
      { label: 'Fecha de salida', value: pkg.departureDate, icon: Calendar },
      { label: 'Duración', value: pkg.duration, icon: Clock },
      ...modality,
      { label: 'Destinos', value: String(destinationCount), icon: MapPin },
    ];
---

<Container class="relative z-20 -mt-6">
  <div
    class:list={[
      'rounded-card-lg bg-white px-5 py-6 shadow-hover md:px-8 md:py-7',
      datesPending && 'lg:flex lg:items-center lg:gap-8',
    ]}
  >
    <dl
      class:list={[
        'grid grid-cols-2 gap-x-6 gap-y-6',
        datesPending
          ? facts.length === 3
            ? 'sm:grid-cols-3 lg:flex-1'
            : 'lg:flex-1'
          : facts.length === 4
            ? 'lg:grid-cols-4'
            : 'lg:grid-cols-3',
      ]}
    >
      {
        facts.map(({ label, value, icon: Icon, wide }) => (
          <div class:list={['flex items-start gap-3', wide && 'col-span-2 sm:col-span-1']}>
            <Icon size={28} aria-hidden="true" class="mt-0.5 size-7 shrink-0 text-violet" />
            <div class="min-w-0">
              <dt class="text-base font-semibold text-muted">{label}</dt>
              <dd class="mt-1 font-display text-xl leading-tight font-bold text-violet-dark lg:text-2xl">
                {value}
              </dd>
            </div>
          </div>
        ))
      }
    </dl>
    {
      datesPending && (
        <Button
          href={getPackageWhatsAppLink(pkg.title)}
          variant="whatsapp"
          class="mt-6 w-full shrink-0 lg:mt-0 lg:w-auto"
        >
          Consultar fechas<span class="sr-only"> de {pkg.title} por WhatsApp</span>
        </Button>
      )
    }
  </div>
</Container>
