---
import { Image } from 'astro:assets';
import { Calendar, Clock } from '@lucide/astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import { getPackageWhatsAppLink } from '../../lib/whatsapp.js';

const { pkg } = Astro.props;
const href = `/paquetes/${pkg.slug}`;
const whatsappHref = getPackageWhatsAppLink(pkg.title);
const isComing = pkg.status === 'proximamente';
const isLastSpots = pkg.status === 'ultimos-lugares';
const isPending = (value) => !value || value === 'A confirmar';
const hasDate = !isPending(pkg.departureDate);
const hasDuration = !isPending(pkg.duration);
---

<article
  class="group relative flex h-full flex-col overflow-hidden rounded-card-lg bg-white shadow-rest motion-safe:transition motion-safe:duration-[250ms] motion-safe:ease-out motion-safe:hover:-translate-y-1 motion-safe:hover:shadow-hover"
>
  <div class="relative aspect-[16/10] overflow-hidden">
    <Image
      src={pkg.image}
      alt={pkg.imageAlt}
      width={640}
      height={400}
      widths={[400, 640, 960]}
      sizes="(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw"
      loading="lazy"
      class="absolute inset-0 h-full w-full object-cover motion-safe:transition motion-safe:duration-[250ms] motion-safe:ease-out motion-safe:group-hover:scale-[1.04]"
    />
    {
      isComing && (
        <div class="absolute inset-0 bg-lilac/50" aria-hidden="true"></div>
      )
    }
    <div class="pointer-events-none absolute top-4 left-4 z-10 flex max-w-[calc(100%-2rem)] flex-wrap gap-2">
      {pkg.accompanied && <Badge>Salida acompañada</Badge>}
      {
        isLastSpots && (
          <Badge class="bg-lilac! text-violet-dark!">Últimos lugares</Badge>
        )
      }
    </div>
  </div>

  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <h3 class="font-display text-2xl leading-tight font-bold text-violet-dark md:text-[1.625rem]">
      <a
        href={href}
        class="inline-flex min-h-12 items-center after:absolute after:inset-0 after:z-0 after:content-['']"
      >
        {pkg.title}
      </a>
    </h3>
    <p class="mt-3 line-clamp-3 text-[1.0625rem] leading-relaxed text-muted">
      {pkg.shortDescription}
    </p>
    <ul class="mt-4 flex flex-col gap-2 text-[1.0625rem] text-violet-dark">
      <li class="flex items-center gap-2">
        <Calendar size={20} aria-hidden="true" class="shrink-0 text-violet-mid" />
        {
          hasDate ? (
            <>
              <span class="sr-only">Fecha de salida:</span>
              <span>{pkg.departureDate}</span>
            </>
          ) : (
            <span>Consultá próximas fechas</span>
          )
        }
      </li>
      {
        hasDuration && (
          <li class="flex items-center gap-2">
            <Clock size={20} aria-hidden="true" class="shrink-0 text-violet-mid" />
            <span class="sr-only">Duración:</span>
            <span>{pkg.duration}</span>
          </li>
        )
      }
    </ul>

    <div class="@container mt-auto pt-6">
      <div class="flex flex-col gap-3 @[22rem]:flex-row">
        {
          !isComing && (
            <Button href={href} class="relative z-10 w-full @[22rem]:flex-1">
              Ver detalles
            </Button>
          )
        }
        <Button
          href={whatsappHref}
          variant="whatsapp-outline"
          class:list={['relative z-10 w-full', isComing ? '' : '@[22rem]:flex-1']}
        >
          {isComing ? 'Avisame cuando salga' : 'Consultar'}
        </Button>
      </div>
    </div>
  </div>
</article>
