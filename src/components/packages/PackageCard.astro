---
import { Image } from 'astro:assets';
import { Calendar, Users } from '@lucide/astro';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import { getPackageWhatsAppLink } from '../../lib/whatsapp.js';

const { pkg, variant = 'horizontal' } = Astro.props;
const vertical = variant === 'vertical';
const href = `/paquetes/${pkg.slug}`;
const whatsappHref = getPackageWhatsAppLink(pkg.title);
const isComing = pkg.status === 'proximamente';
const isLastSpots = pkg.status === 'ultimos-lugares';
const isPending = (value) => !value || value === 'A confirmar';
const hasDate = !isPending(pkg.departureDate);
const hasDuration = !isPending(pkg.duration);
const dateText = hasDate
  ? [pkg.departureDate, hasDuration && pkg.duration].filter(Boolean).join(' · ')
  : 'Consultá próximas fechas';

// El violeta se mantiene denso donde va el texto (hasta el 45 %) y se apaga al 55 %:
// así el blanco y el lila suave pasan AA aunque la foto sea clara.
const photoScrim =
  'bg-[linear-gradient(to_top,color-mix(in_srgb,var(--color-violet-dark)_94%,transparent)_0%,color-mix(in_srgb,var(--color-violet-dark)_86%,transparent)_30%,color-mix(in_srgb,var(--color-violet-dark)_74%,transparent)_45%,transparent_55%)]';

const imageClass =
  'h-full w-full object-cover motion-safe:transition-transform motion-safe:duration-500 motion-safe:ease-out motion-safe:group-hover/card:scale-[1.06]';
const buttonArrow = 'motion-safe:group-hover/card:[&_.lucide-arrow-right]:translate-x-[3px]';
---

<article
  class="group/card relative flex h-full flex-col overflow-hidden rounded-3xl bg-white shadow-[0_24px_56px_-24px_color-mix(in_srgb,var(--color-violet-dark)_24%,transparent)] motion-safe:transition motion-safe:duration-300 motion-safe:ease-out motion-safe:hover:-translate-y-1.5 motion-safe:hover:shadow-[0_32px_64px_-24px_color-mix(in_srgb,var(--color-violet-dark)_32%,transparent)]"
>
  {
    vertical ? (
      <div class="isolate grid aspect-[4/5] overflow-hidden">
        <Image
          src={pkg.image}
          alt={pkg.imageAlt}
          width={480}
          height={600}
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw"
          loading="lazy"
          class:list={['relative -z-10 [grid-area:1/1]', imageClass]}
        />
        <div class:list={['[grid-area:1/1]', photoScrim]} aria-hidden="true" />
        <div class="flex min-w-0 flex-col justify-end p-6 [grid-area:1/1]">
          {
            pkg.destinations.length > 0 && (
              <p class="truncate text-[0.9375rem] leading-snug font-medium text-lilac-soft">
                {pkg.destinations.join(' · ')}
              </p>
            )
          }
          <h3 class="mt-1 font-display text-[1.75rem] leading-[1.15] font-bold text-white">
            <a
              href={href}
              class="inline-flex min-h-12 items-center text-balance focus-visible:outline-white after:absolute after:inset-0 after:z-0 after:content-['']"
            >
              {pkg.title}
            </a>
          </h3>
          <p class="mt-1 flex items-center gap-2 text-base text-white">
            <Calendar size={18} aria-hidden="true" class="shrink-0 text-lilac-soft" />
            {hasDate && <span class="sr-only">Fecha de salida:</span>}
            {dateText}
          </p>
        </div>
      </div>
    ) : (
      <div class="relative aspect-[16/10] overflow-hidden">
        <Image
          src={pkg.image}
          alt={pkg.imageAlt}
          width={640}
          height={400}
          widths={[400, 640, 960]}
          sizes="(min-width: 1024px) 380px, (min-width: 768px) 50vw, 100vw"
          loading="lazy"
          class:list={['absolute inset-0', imageClass]}
        />
        {isComing && <div class="absolute inset-0 bg-lilac/50" aria-hidden="true" />}
      </div>
    )
  }

  <div class="pointer-events-none absolute top-4 left-4 z-10 flex max-w-[calc(100%-2rem)] flex-wrap gap-2">
    {
      pkg.accompanied && (
        <Badge class="gap-1.5 bg-white! text-violet-dark! shadow-rest">
          <Users size={18} aria-hidden="true" class="shrink-0" />
          Salida acompañada
        </Badge>
      )
    }
    {isLastSpots && <Badge class="bg-lilac! text-violet-dark!">Últimos lugares</Badge>}
  </div>

  <div class:list={['flex flex-1 flex-col', vertical ? 'p-4 sm:p-5' : 'p-5 sm:p-6']}>
    {
      !vertical && (
        <>
          <h3 class="font-display text-2xl leading-tight font-bold text-violet-dark md:text-[1.625rem]">
            {isComing ? (
              <span class="inline-flex min-h-12 items-center">{pkg.title}</span>
            ) : (
              <a
                href={href}
                class="inline-flex min-h-12 items-center after:absolute after:inset-0 after:z-0 after:content-['']"
              >
                {pkg.title}
              </a>
            )}
          </h3>
          <p class="mt-3 line-clamp-3 text-[1.0625rem] leading-relaxed text-muted">
            {pkg.shortDescription}
          </p>
          <p class="mt-4 flex items-center gap-2 text-[1.0625rem] text-violet-dark">
            <Calendar size={20} aria-hidden="true" class="shrink-0 text-violet-mid" />
            {hasDate && <span class="sr-only">Fecha de salida:</span>}
            {dateText}
          </p>
        </>
      )
    }

    <div class:list={['flex gap-3', vertical ? '' : 'mt-auto pt-6']}>
      {
        isComing ? (
          <Button href={whatsappHref} variant="whatsapp-outline" class="relative z-10 w-full">
            Avisame cuando salga
          </Button>
        ) : (
          <>
            <Button href={href} class:list={['relative z-10 flex-1', buttonArrow]}>
              Ver el viaje
            </Button>
            <Button
              href={whatsappHref}
              variant="whatsapp-outline"
              class="relative z-10 size-13 shrink-0 px-0!"
            >
              <span class="sr-only">Consultar por WhatsApp sobre {pkg.title}</span>
            </Button>
          </>
        )
      }
    </div>
  </div>
</article>
