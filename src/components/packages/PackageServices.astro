---
import { Check, X } from '@lucide/astro';

const { included = [], excluded = [] } = Astro.props;
const hasIncluded = included.length > 0;
const hasExcluded = excluded.length > 0;
---

{
  (hasIncluded || hasExcluded) && (
    <div class="grid gap-10 md:grid-cols-2 md:gap-8">
      {hasIncluded && (
        <section aria-labelledby="incluye-titulo">
          <h2
            id="incluye-titulo"
            class="font-display text-3xl leading-tight font-bold text-violet-dark md:text-4xl"
          >
            Qué incluye
          </h2>
          <ul class="mt-6 space-y-4">
            {included.map((item) => (
              <li class="flex items-start gap-3">
                <Check size={22} aria-hidden="true" class="mt-1 size-[22px] shrink-0 text-whatsapp" />
                <span class="text-lg leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
      {hasExcluded && (
        <section aria-labelledby="no-incluye-titulo">
          <h2
            id="no-incluye-titulo"
            class="font-display text-3xl leading-tight font-bold text-violet-dark md:text-4xl"
          >
            Qué no incluye
          </h2>
          <ul class="mt-6 space-y-4">
            {excluded.map((item) => (
              <li class="flex items-start gap-3">
                <X size={22} aria-hidden="true" class="mt-1 size-[22px] shrink-0 text-muted" />
                <span class="text-lg leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  )
}
