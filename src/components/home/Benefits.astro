---
import { Medal, MessageCircle, Plane, Users } from '@lucide/astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const benefits = [
  {
    title: 'Trayectoria en Trelew',
    description: 'Una agencia local, con oficina en el centro de la ciudad.',
    icon: Medal,
  },
  {
    title: 'Atención personalizada',
    description: 'Te asesoramos de manera directa, sin intermediarios.',
    icon: Users,
  },
  {
    title: 'Salidas acompañadas',
    description: 'Viajás en grupo, con coordinación de la agencia.',
    icon: Plane,
  },
  {
    title: 'Asesoramiento cercano',
    description: 'Te acompañamos antes, durante y después del viaje.',
    icon: MessageCircle,
  },
];
---

<section class="bg-violet-dark py-18 lg:py-28" aria-labelledby="beneficios-titulo">
  <Container>
    <SectionHeading
      id="beneficios-titulo"
      eyebrow="Nuestra forma de viajar"
      title="¿Por qué viajar con Molinari?"
      align="center"
      tone="light"
    />
    <ul class="mt-12 grid grid-cols-1 gap-5 md:grid-cols-2 lg:mt-14 lg:grid-cols-4 lg:gap-6">
      {
        benefits.map(({ title, description, icon: Icon }) => (
          <li class="h-full rounded-card-lg border border-white/10 bg-white/6 p-7 motion-safe:transition motion-safe:duration-300 motion-safe:ease-out hover:border-lilac/40 motion-safe:hover:-translate-y-1 lg:p-8">
            <span class="inline-flex size-14 items-center justify-center rounded-full bg-lilac/15">
              <Icon size={28} aria-hidden="true" class="size-7 text-lilac" />
            </span>
            <h3 class="mt-5 font-display text-xl leading-snug font-bold text-white">{title}</h3>
            <p class="mt-2 leading-relaxed text-lilac-soft">{description}</p>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
