  {
    desktop: budapest,
    mobile: budapestMobile,
    alt: 'El Parlamento de Budapest iluminado de noche, a orillas del Danubio.',
    focus: 'lg:object-[70%_78%]',
    focusMobile: 'center top',
  },
];

const slides = await Promise.all(
  definitions.map(async ({ desktop, mobile, desktopWidths, ...slide }) => {
    const [wide, tall] = await Promise.all([
      optimized(desktop, desktopWidths ?? photoWidths),
      optimized(mobile, mobileWidths),
    ]);
    return { ...slide, wide, tall };
