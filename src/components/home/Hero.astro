---
import { Image, getImage } from 'astro:assets';
import { HeartHandshake, MapPin, Users } from '@lucide/astro';
import roma from '../../assets/images/hero/hero-roma.jpg';
import japon from '../../assets/images/hero/hero-japon.jpg';
import londres from '../../assets/images/hero/hero-londres.jpg';
import nuevaYork from '../../assets/images/hero/hero-nueva-york.jpg';
import praga from '../../assets/images/hero/hero-praga.jpg';
import budapest from '../../assets/images/hero/hero-budapest.jpg';
import logoCielo from '../../assets/images/hero/hero-logo-cielo.png';
import logoCieloMobile from '../../assets/images/hero/hero-logo-cielo-mobile.jpeg';
import logoTokio from '../../assets/images/hero/hero-logo-tokio.png';
import logoTokioMobile from '../../assets/images/hero/hero-logo-tokio-mobile.jpeg';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { getGeneralWhatsAppLink } from '../../lib/whatsapp.js';

function brandImage(src, widths) {
  return getImage({ src, widths, sizes: '100vw', format: 'webp' });
}

const [cieloWide, cieloTall, tokioWide, tokioTall] = await Promise.all([
  brandImage(logoCielo, [1280, 1600, 1920, 2560]),
  brandImage(logoCieloMobile, [640, 960, 1280]),
  brandImage(logoTokio, [1280, 1600, 1920, 2560]),
  brandImage(logoTokioMobile, [640, 960, 1280]),
]);

const slides = [
  {
    image: logoCielo,
    imageMobile: logoCieloMobile,
    wide: cieloWide,
    tall: cieloTall,
    alt: 'Logo de Molinari Viajes sobre un cielo con nubes',
    brand: true,
  },
  {
    image: roma,
    alt: 'El Coliseo de Roma iluminado por el sol de la tarde, bajo un cielo despejado.',
    focus: 'object-[center_62%]',
  },
  {
    image: japon,
    alt: 'El monte Fuji nevado detrás de una pagoda roja, rodeada de árboles.',
    focus: 'object-[center_42%]',
  },
  {
    image: londres,
    alt: 'El río Támesis en Londres al atardecer, con el Tower Bridge a la izquierda.',
    focus: 'object-[center_58%]',
  },
  {
    image: logoTokio,
    imageMobile: logoTokioMobile,
    wide: tokioWide,
    tall: tokioTall,
    alt: 'Logo de Molinari Viajes sobre una calle de Tokio de noche',
    brand: true,
  },
  {
    image: nuevaYork,
    alt: 'Vista aérea de Manhattan y el río Hudson al anochecer, con las luces de la ciudad encendidas.',
    focus: 'object-[center_45%]',
  },
  {
    image: praga,
    alt: 'Los puentes de Praga sobre el río Moldava, con los techos rojos de la ciudad.',
    focus: 'object-[center_70%]',
  },
  {
    image: budapest,
    alt: 'El Parlamento de Budapest iluminado de noche, a orillas del Danubio.',
    focus: 'object-[70%_78%]',
  },
];

const trust = [
  { icon: MapPin, label: 'Oficina en Belgrano 461' },
  { icon: Users, label: 'Salidas acompañadas desde Trelew' },
  { icon: HeartHandshake, label: 'Atención personalizada' },
];

---

<section
  class="relative isolate flex min-h-[85svh] flex-col overflow-hidden bg-violet-dark lg:block lg:h-[clamp(780px,92svh,1200px)] lg:min-h-0"
  aria-labelledby="hero-titulo"
  data-hero
>
  <div class="absolute inset-0 overflow-hidden">
    {
      slides.map((slide, i) => (
        <div
          class:list={['hero-slide absolute inset-0', i === 0 && 'is-active']}
          data-slide
          data-brand={slide.brand ? '' : undefined}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          {
            slide.imageMobile ? (
              <picture>
                <source media="(min-width: 1024px)" srcset={slide.wide.srcSet.attribute} sizes="100vw" />
                <img
                  src={slide.tall.src}
                  srcset={slide.tall.srcSet.attribute}
                  alt={slide.alt}
                  width={slide.tall.attributes.width}
                  height={slide.tall.attributes.height}
                  sizes="100vw"
                  class="h-full w-full object-contain object-top lg:object-cover lg:object-center"
                  {...(i === 0
                    ? { fetchpriority: 'high', decoding: 'async' }
                    : { loading: 'lazy', decoding: 'async', fetchpriority: 'low' })}
                />
              </picture>
            ) : (
              <Image
                src={slide.image}
                alt={slide.alt}
                width={1920}
                height={Math.round((1920 * slide.image.height) / slide.image.width)}
                widths={[640, 960, 1280, 1600, 1920]}
                sizes="100vw"
                class:list={['h-full w-full object-cover', slide.focus]}
                {...(i === 0
                  ? { priority: true }
                  : { loading: 'lazy', decoding: 'async', fetchpriority: 'low' })}
              />
            )
          }
        </div>
      ))
    }
    <div class="hero-scrim pointer-events-none absolute inset-0 z-10" aria-hidden="true"></div>
  </div>

  <div
    class="hero-copy relative z-10 mt-auto w-full lg:pointer-events-none lg:absolute lg:inset-0 lg:mt-0 lg:flex lg:items-center"
  >
    <Container class="pb-8 lg:pt-0 lg:pb-8">
      <div class="pointer-events-auto lg:max-w-[34rem] xl:max-w-[600px]">
        <Eyebrow tone="light" class="text-lilac-soft!">Agencia de viajes en Trelew</Eyebrow>
        <h1
          id="hero-titulo"
          class="mt-3 font-display text-4xl leading-[1.05] font-extrabold tracking-[-0.02em] text-white lg:mt-5 lg:text-[3.5rem] xl:text-[4rem]"
        >
          Viajá con la experiencia de <span class="text-lilac">Molinari Viajes</span>
        </h1>
        <p class="mt-3 max-w-[34rem] text-lg leading-snug text-white/85 lg:mt-5 lg:text-xl lg:leading-relaxed">
          Desde Trelew al mundo, con salidas acompañadas y asesoramiento personalizado.
        </p>
        <div class="mt-5 flex flex-col gap-3 lg:mt-7 lg:flex-row lg:flex-wrap">
          <Button
            href="#paquetes"
            variant="secondary"
            size="large"
            class="w-full border-white! focus-visible:outline-white lg:w-auto"
          >
            Ver paquetes
          </Button>
          <Button
            href={getGeneralWhatsAppLink()}
            variant="whatsapp"
            size="large"
            class="w-full focus-visible:outline-white lg:w-auto"
          >
            Hablar por WhatsApp
          </Button>
        </div>
        <ul class="mt-4 flex flex-col gap-1.5 text-[0.9375rem] leading-snug text-white/80 lg:mt-7 lg:flex-row lg:flex-wrap lg:gap-2.5 lg:gap-x-6">
          {
            trust.map(({ icon: Icon, label }) => (
              <li class="flex items-center gap-2">
                <Icon size={18} aria-hidden="true" class="shrink-0 text-lilac" />
                {label}
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </div>
</section>

<script>
  const hero = document.querySelector('[data-hero]');

  if (hero instanceof HTMLElement) {
    const slides = [...hero.querySelectorAll('[data-slide]')];
    const leaveTimers = new Map();
    let index = 0;
    let holding = false;

    hero.toggleAttribute('data-ready', true);

    function updatePaused() {
      hero.toggleAttribute('data-paused', holding || document.hidden);
    }

    function releaseHold() {
      if (!holding) return;
      holding = false;
      updatePaused();
    }

    function show(next) {
      if (next === index) return;
      const current = slides[index];
      const target = slides[next];
      const targetImg = target.querySelector('img');

      if (targetImg instanceof HTMLImageElement && !targetImg.complete) {
        targetImg.addEventListener('load', () => show(next), { once: true });
        return;
      }

      const currentImg = current.querySelector('img');
      if (currentImg instanceof HTMLImageElement) {
        currentImg.style.scale = getComputedStyle(currentImg).scale;
      }
      current.classList.remove('is-active');
      current.classList.add('is-leaving');
      current.setAttribute('aria-hidden', 'true');
      window.clearTimeout(leaveTimers.get(current));
      leaveTimers.set(
        current,
        window.setTimeout(() => {
          current.classList.remove('is-leaving');
          currentImg?.style.removeProperty('scale');
        }, 1600),
      );

      window.clearTimeout(leaveTimers.get(target));
      target.classList.remove('is-leaving');
      targetImg?.style.removeProperty('scale');
      target.classList.add('is-active');
      target.removeAttribute('aria-hidden');

      index = next;
    }

    hero.addEventListener('animationend', (event) => {
      if (event.animationName !== 'hero-zoom') return;
      const img = event.target;
      if (!(img instanceof HTMLImageElement)) return;
      if (img.closest('[data-slide]') !== slides[index]) return;
      show((index + 1) % slides.length);
    });

    hero.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      holding = true;
      updatePaused();
    });
    window.addEventListener('pointerup', releaseHold);
    window.addEventListener('pointercancel', releaseHold);

    document.addEventListener('visibilitychange', updatePaused);
    updatePaused();
  }
</script>
