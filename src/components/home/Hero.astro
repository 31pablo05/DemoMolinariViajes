---
import { getImage } from 'astro:assets';
import { HeartHandshake, MapPin, Users } from '@lucide/astro';
import roma from '../../assets/images/hero/hero-roma.jpg';
import romaMobile from '../../assets/images/hero/hero-roma-mobile.png';
import japon from '../../assets/images/hero/hero-japon.jpg';
import japonMobile from '../../assets/images/hero/hero-japon-mobile.png';
import londres from '../../assets/images/hero/hero-londres.jpg';
import londresMobile from '../../assets/images/hero/hero-londres-mobile.png';
import nuevaYork from '../../assets/images/hero/hero-nueva-york.jpg';
import nuevaYorkMobile from '../../assets/images/hero/hero-nueva-york-mobile.png';
import praga from '../../assets/images/hero/hero-praga.jpg';
import pragaMobile from '../../assets/images/hero/hero-praga-mobile.png';
import budapest from '../../assets/images/hero/hero-budapest.jpg';
import budapestMobile from '../../assets/images/hero/hero-budapest-mobile.png';
import logoCielo from '../../assets/images/hero/hero-logo-cielo.png';
import logoCieloMobile from '../../assets/images/hero/hero-logo-cielo-mobile.png';
import logoTokio from '../../assets/images/hero/hero-logo-tokio.png';
import logoTokioMobile from '../../assets/images/hero/hero-logo-tokio-mobile.png';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { getGeneralWhatsAppLink } from '../../lib/whatsapp.js';

const photoWidths = [640, 960, 1280, 1600, 1920];
const brandWidths = [1280, 1600, 1920, 2560];
const mobileWidths = [640, 960, 1280];

function optimized(src, widths) {
  return getImage({ src, widths, sizes: '100vw', format: 'webp' });
}

const definitions = [
  {
    desktop: logoCielo,
    mobile: logoCieloMobile,
    desktopWidths: brandWidths,
    alt: 'Logo de Molinari Viajes sobre un cielo con nubes',
    brand: true,
    focusMobile: 'center 30%',
  },
  {
    desktop: roma,
    mobile: romaMobile,
    alt: 'El Coliseo de Roma iluminado por el sol de la tarde, bajo un cielo despejado.',
    focus: 'lg:object-[center_62%]',
    focusMobile: 'center top',
  },
  {
    desktop: japon,
    mobile: japonMobile,
    alt: 'El monte Fuji nevado detrás de una pagoda roja, rodeada de árboles.',
    focus: 'lg:object-[center_42%]',
    focusMobile: 'center top',
  },
  {
    desktop: londres,
    mobile: londresMobile,
    alt: 'El río Támesis en Londres al atardecer, con el Tower Bridge a la izquierda.',
    focus: 'lg:object-[center_58%]',
    focusMobile: 'center top',
  },
  {
    desktop: logoTokio,
    mobile: logoTokioMobile,
    desktopWidths: brandWidths,
    alt: 'Logo de Molinari Viajes sobre una calle de Tokio de noche',
    brand: true,
    focusMobile: 'center 30%',
  },
  {
    desktop: nuevaYork,
    mobile: nuevaYorkMobile,
    alt: 'Vista aérea de Manhattan y el río Hudson al anochecer, con las luces de la ciudad encendidas.',
    focus: 'lg:object-[center_45%]',
    focusMobile: 'center top',
  },
  {
    desktop: praga,
    mobile: pragaMobile,
    alt: 'Los puentes de Praga sobre el río Moldava, con los techos rojos de la ciudad.',
    focus: 'lg:object-[center_70%]',
    focusMobile: 'center top',
  },
  {
    desktop: budapest,
    mobile: budapestMobile,
    alt: 'El Parlamento de Budapest iluminado de noche, a orillas del Danubio.',
    focus: 'lg:object-[70%_78%]',
    focusMobile: 'center top',
  },
];

const slides = await Promise.all(
  definitions.map(async ({ desktop, mobile, desktopWidths, ...slide }) => {
    const [wide, tall] = await Promise.all([
      optimized(desktop, desktopWidths ?? photoWidths),
      optimized(mobile, mobileWidths),
    ]);
    return { ...slide, wide, tall };
  }),
);

const trust = [
  { icon: MapPin, label: 'Oficina en Belgrano 461' },
  { icon: Users, label: 'Salidas acompañadas desde Trelew' },
  { icon: HeartHandshake, label: 'Atención personalizada' },
];

---

<section
  class="relative isolate flex h-[calc(100svh-(5.25rem+2.125rem))] flex-col overflow-hidden bg-violet-dark lg:block lg:h-[clamp(780px,92svh,1200px)] lg:min-h-0"
  aria-labelledby="hero-titulo"
  data-hero
>
  <div class="absolute inset-0 overflow-hidden">
    {
      slides.map((slide, i) => (
        <div
          class:list={['hero-slide absolute inset-0', i === 0 && 'is-active']}
          data-slide
          data-brand={slide.brand ? '' : undefined}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <picture class="relative block h-full w-full">
            <source
              media="(min-width: 1024px)"
              srcset={slide.wide.srcSet.attribute}
              sizes="100vw"
              {...(i === 0 ? { fetchpriority: 'high' } : { fetchpriority: 'low' })}
            />
            <img
              src={slide.tall.src}
              srcset={slide.tall.srcSet.attribute}
              alt={slide.alt}
              width={slide.tall.attributes.width}
              height={slide.tall.attributes.height}
              sizes="100vw"
              class:list={[
                'h-full w-full object-cover max-lg:absolute max-lg:inset-0 max-lg:[object-position:var(--hero-focus)] max-lg:[transform-origin:var(--hero-focus)]',
                slide.brand ? 'lg:object-center' : slide.focus,
              ]}
              style={{ '--hero-focus': slide.focusMobile ?? 'center top' }}
              {...(i === 0
                ? { fetchpriority: 'high', decoding: 'async' }
                : { loading: 'lazy', decoding: 'async', fetchpriority: 'low' })}
            />
          </picture>
        </div>
      ))
    }
    <div
      class="hero-scrim pointer-events-none absolute inset-0 z-10 max-lg:bg-[linear-gradient(to_bottom,color-mix(in_srgb,var(--color-violet-dark)_20%,transparent),transparent_10%)]"
      aria-hidden="true"
    ></div>
  </div>

  <div
    class="hero-copy relative z-10 mt-auto w-full lg:pointer-events-none lg:absolute lg:inset-0 lg:mt-0 lg:flex lg:items-center"
  >
    <Container class="max-lg:px-4! max-lg:pb-4 lg:pt-0 lg:pb-8">
      <div
        class="pointer-events-auto max-lg:rounded-3xl max-lg:border max-lg:border-white/15 max-lg:bg-violet-dark/85 max-lg:p-5 max-lg:backdrop-blur-3xl max-lg:supports-[backdrop-filter]:bg-violet-dark/60! lg:max-w-[34rem] xl:max-w-[600px]"
      >
        <Eyebrow tone="light" class="max-lg:text-white! lg:text-lilac-soft!">Agencia de viajes en Trelew</Eyebrow>
        <h1
          id="hero-titulo"
          class="mt-2 font-display text-[1.75rem] leading-[1.05] font-extrabold tracking-[-0.02em] text-white lg:mt-5 lg:text-[3.5rem] xl:text-[4rem]"
        >
          Viajá con la experiencia de <span class="text-lilac-soft lg:text-lilac">Molinari Viajes</span>
        </h1>
        <p class="mt-2 max-w-[34rem] text-[0.9375rem] leading-snug text-white lg:mt-5 lg:text-xl lg:leading-relaxed lg:text-white/85">
          Desde Trelew al mundo, con salidas acompañadas y asesoramiento personalizado.
        </p>
        <div class="mt-3 flex flex-col gap-2 lg:mt-7 lg:flex-row lg:flex-wrap lg:gap-3">
          <Button
            href="#paquetes"
            variant="secondary"
            size="large"
            class="w-full border-white! focus-visible:outline-white max-lg:min-h-12 lg:w-auto"
          >
            Ver paquetes
          </Button>
          <Button
            href={getGeneralWhatsAppLink()}
            variant="whatsapp"
            size="large"
            class="w-full focus-visible:outline-white max-lg:min-h-12 lg:w-auto"
          >
            Hablar por WhatsApp
          </Button>
        </div>
        <ul class="hidden text-[0.9375rem] leading-snug text-white/80 lg:mt-7 lg:flex lg:flex-row lg:flex-wrap lg:gap-2.5 lg:gap-x-6">
          {
            trust.map(({ icon: Icon, label }) => (
              <li class="flex items-center gap-2">
                <Icon size={18} aria-hidden="true" class="shrink-0 text-lilac" />
                {label}
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </div>
</section>

<script>
  const hero = document.querySelector('[data-hero]');

  if (hero instanceof HTMLElement) {
    const slides = [...hero.querySelectorAll('[data-slide]')];
    const leaveTimers = new Map();
    let index = 0;
    let holding = false;

    hero.toggleAttribute('data-ready', true);

    function updatePaused() {
      hero.toggleAttribute('data-paused', holding || document.hidden);
    }

    function releaseHold() {
      if (!holding) return;
      holding = false;
      updatePaused();
    }

    function show(next) {
      if (next === index) return;
      const current = slides[index];
      const target = slides[next];
      const targetImg = target.querySelector('img');

      if (targetImg instanceof HTMLImageElement && !targetImg.complete) {
        targetImg.addEventListener('load', () => show(next), { once: true });
        return;
      }

      const currentImg = current.querySelector('img');
      if (currentImg instanceof HTMLImageElement) {
        currentImg.style.scale = getComputedStyle(currentImg).scale;
      }
      current.classList.remove('is-active');
      current.classList.add('is-leaving');
      current.setAttribute('aria-hidden', 'true');
      window.clearTimeout(leaveTimers.get(current));
      leaveTimers.set(
        current,
        window.setTimeout(() => {
          current.classList.remove('is-leaving');
          currentImg?.style.removeProperty('scale');
        }, 1600),
      );

      window.clearTimeout(leaveTimers.get(target));
      target.classList.remove('is-leaving');
      targetImg?.style.removeProperty('scale');
      target.classList.add('is-active');
      target.removeAttribute('aria-hidden');

      index = next;
    }

    hero.addEventListener('animationend', (event) => {
      if (event.animationName !== 'hero-zoom') return;
      const img = event.target;
      if (!(img instanceof HTMLImageElement)) return;
      if (img.closest('[data-slide]') !== slides[index]) return;
      show((index + 1) % slides.length);
    });

    hero.addEventListener('pointerdown', (event) => {
      if (event.pointerType === 'mouse') return;
      holding = true;
      updatePaused();
    });
    window.addEventListener('pointerup', releaseHold);
    window.addEventListener('pointercancel', releaseHold);

    document.addEventListener('visibilitychange', updatePaused);
    updatePaused();
  }
</script>
