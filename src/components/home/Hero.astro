const photoWidths = [640, 960, 1280, 1600, 1920];
const brandWidths = [1280, 1600, 1920, 2560];
const mobileWidths = [640, 960, 1280];

function optimized(src, widths) {
  return getImage({ src, widths, sizes: '100vw', format: 'webp' });
}

const definitions = [
  {
    desktop: logoCielo,
    mobile: logoCieloMobile,
    desktopWidths: brandWidths,
    alt: 'Logo de Molinari Viajes sobre un cielo con nubes',
    brand: true,
    focusMobile: 'center 30%',
  },
  {
    desktop: roma,
    mobile: romaMobile,
    alt: 'El Coliseo de Roma iluminado por el sol de la tarde, bajo un cielo despejado.',
    focus: 'lg:object-[center_62%]',
    focusMobile: 'center top',
  },
  {
    desktop: japon,
    mobile: japonMobile,
    alt: 'El monte Fuji nevado detrás de una pagoda roja, rodeada de árboles.',
    focus: 'lg:object-[center_42%]',
    focusMobile: 'center top',
  },
  {
    desktop: londres,
    mobile: londresMobile,
    alt: 'El río Támesis en Londres al atardecer, con el Tower Bridge a la izquierda.',
