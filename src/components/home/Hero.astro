---

<section
  class="relative isolate flex h-[calc(100svh-(5.25rem+2.125rem))] flex-col overflow-hidden bg-violet-dark lg:block lg:h-[clamp(780px,92svh,1200px)] lg:min-h-0"
  aria-labelledby="hero-titulo"
  data-hero
>
  <div class="absolute inset-0 overflow-hidden">
    {
      slides.map((slide, i) => (
        <div
          class:list={['hero-slide absolute inset-0', i === 0 && 'is-active']}
          data-slide
          data-brand={slide.brand ? '' : undefined}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <picture class="relative block h-full w-full">
            <source
              media="(min-width: 1024px)"
              srcset={slide.wide.srcSet.attribute}
              sizes="100vw"
              {...(i === 0 ? { fetchpriority: 'high' } : { fetchpriority: 'low' })}
            />
            <img
              src={slide.tall.src}
              srcset={slide.tall.srcSet.attribute}
              alt={slide.alt}
              width={slide.tall.attributes.width}
              height={slide.tall.attributes.height}
              sizes="100vw"
              class:list={[
                'h-full w-full object-cover max-lg:[object-position:var(--hero-focus)] max-lg:[transform-origin:var(--hero-focus)]',
                slide.brand
                  ? 'lg:object-center max-lg:absolute max-lg:top-[-41%]! max-lg:left-1/2 max-lg:h-[141%]! max-lg:w-auto! max-lg:max-w-none max-lg:min-w-full max-lg:-translate-x-1/2'
                  : ['max-lg:absolute max-lg:inset-0', slide.focus],
              ]}
              style={{ '--hero-focus': slide.focusMobile ?? 'center top' }}
              {...(i === 0
                ? { fetchpriority: 'high', decoding: 'async' }
                : { loading: 'lazy', decoding: 'async', fetchpriority: 'low' })}
            />
          </picture>
        </div>
      ))
    }
    <div
      class:list={['hero-scrim pointer-events-none absolute inset-0 z-10', mobileScrim, mobileScrimShort, desktopScrim, desktopScrimWide]}
      aria-hidden="true"
    ></div>
  </div>

  <div
    class="hero-copy relative z-10 mt-auto w-full lg:pointer-events-none lg:absolute lg:inset-0 lg:mt-0 lg:flex lg:items-center"
  >
    <Container class="max-lg:px-5! max-lg:pb-7 lg:pt-0 lg:pb-8">
      <div class="pointer-events-auto lg:max-w-[34rem] xl:max-w-[600px]">
        <Eyebrow tone="light" class:list={['max-lg:text-white! max-lg:whitespace-nowrap lg:text-lilac-soft!', mobileReadability, desktopReadability]}>
          Agencia de viajes en Trelew
        </Eyebrow>
        <h1
          id="hero-titulo"
          class:list={[
            'mt-2 font-display text-[1.75rem] leading-[1.05] font-extrabold tracking-[-0.04em] text-white lg:mt-5 lg:text-[3.5rem] lg:tracking-[-0.02em] xl:text-[4rem]',
            mobileReadability,
            desktopReadability,
          ]}
        >
          Viajá con la experiencia de <span class="text-lilac-soft lg:text-lilac">Molinari Viajes</span>
        </h1>
