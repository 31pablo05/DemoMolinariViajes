---
import { Image } from 'astro:assets';
import { ArrowRight, HeartHandshake, MapPin, Pause, Play, Users } from '@lucide/astro';
import roma from '../../assets/images/hero/hero-roma.jpg';
import japon from '../../assets/images/hero/hero-japon.jpg';
import londres from '../../assets/images/hero/hero-londres.jpg';
import nuevaYork from '../../assets/images/hero/hero-nueva-york.jpg';
import praga from '../../assets/images/hero/hero-praga.jpg';
import budapest from '../../assets/images/hero/hero-budapest.jpg';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import { getGeneralWhatsAppLink } from '../../lib/whatsapp.js';

const slides = [
  {
    image: roma,
    alt: 'El Coliseo de Roma iluminado por el sol de la tarde, bajo un cielo despejado.',
    destination: 'Roma',
    href: '/paquetes/europa-central',
  },
  {
    image: japon,
    alt: 'El monte Fuji nevado detrás de una pagoda roja, rodeada de árboles.',
    destination: 'Japón',
    href: '/paquetes/japon-nueva-york',
  },
  {
    image: londres,
    alt: 'El río Támesis en Londres al atardecer, con el Tower Bridge a la izquierda.',
    destination: 'Gran Bretaña',
    href: '/paquetes',
  },
  {
    image: nuevaYork,
    alt: 'Vista aérea de Manhattan y el río Hudson al anochecer, con las luces de la ciudad encendidas.',
    destination: 'Nueva York',
    href: '/paquetes/japon-nueva-york',
  },
  {
    image: praga,
    alt: 'Los puentes de Praga sobre el río Moldava, con los techos rojos de la ciudad.',
    destination: 'Praga',
    href: '/paquetes/europa-central',
  },
  {
    image: budapest,
    alt: 'El Parlamento de Budapest iluminado de noche, a orillas del Danubio.',
    destination: 'Budapest',
    href: '/paquetes/europa-central',
  },
];

const trust = [
  { icon: MapPin, label: 'Oficina en Belgrano 461' },
  { icon: Users, label: 'Salidas acompañadas desde Trelew' },
  { icon: HeartHandshake, label: 'Atención personalizada' },
];

const [first] = slides;
const mediaBox = 'aspect-[4/3] md:aspect-video lg:aspect-auto lg:h-full';
const toggleClass =
  'pointer-events-auto size-11 shrink-0 cursor-pointer items-center justify-center rounded-pill border border-white/30 bg-violet-dark/60 text-white backdrop-blur-md hover:bg-violet-dark/80 focus-visible:outline-white motion-reduce:hidden! lg:bg-white/15 lg:hover:bg-white/25';
---

<section
  class="group/hero relative isolate overflow-hidden bg-violet-dark lg:h-[640px]"
  aria-labelledby="hero-titulo"
  data-hero
>
  <div class:list={['relative overflow-hidden lg:absolute lg:inset-0', mediaBox]}>
    {
      slides.map((slide, i) => (
        <div
          class:list={['hero-slide absolute inset-0', i === 0 && 'is-active']}
          data-slide
          data-destination={slide.destination}
          data-href={slide.href}
          aria-hidden={i === 0 ? undefined : 'true'}
        >
          <Image
            src={slide.image}
            alt={slide.alt}
            width={1920}
            height={Math.round((1920 * slide.image.height) / slide.image.width)}
            widths={[640, 960, 1280, 1600, 1920]}
            sizes="100vw"
            class="h-full w-full object-cover"
            {...(i === 0
              ? { priority: true }
              : { loading: 'lazy', decoding: 'async', fetchpriority: 'low' })}
          />
        </div>
      ))
    }
    <div class="hero-scrim pointer-events-none absolute inset-0 z-10" aria-hidden="true"></div>
  </div>

  <div
    class="relative z-10 -mt-7 rounded-t-[28px] bg-violet-dark lg:pointer-events-none lg:absolute lg:inset-0 lg:mt-0 lg:flex lg:items-center lg:rounded-none lg:bg-transparent"
  >
    <Container class="pt-9 pb-12 lg:pt-0 lg:pb-8">
      <div class="lg:pointer-events-auto lg:max-w-[34rem] xl:max-w-[600px]">
        <Eyebrow tone="light" class="text-lilac-soft!">Agencia de viajes en Trelew</Eyebrow>
        <h1
          id="hero-titulo"
          class="mt-4 font-display text-4xl leading-[1.05] font-extrabold tracking-[-0.02em] text-white lg:mt-5 lg:text-[3.5rem] xl:text-[4rem]"
        >
          Viajá con la experiencia de <span class="text-lilac">Molinari Viajes</span>
        </h1>
        <p class="mt-5 max-w-[34rem] text-lg leading-relaxed text-white/85 lg:text-xl">
          Desde Trelew al mundo, con salidas acompañadas y asesoramiento personalizado.
        </p>
        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <Button
            href="#paquetes"
            variant="secondary"
            size="large"
            class="w-full border-white! focus-visible:outline-white sm:w-auto"
          >
            Ver paquetes
          </Button>
          <Button
            href={getGeneralWhatsAppLink()}
            variant="whatsapp"
            size="large"
            class="w-full focus-visible:outline-white sm:w-auto"
          >
            Hablar por WhatsApp
          </Button>
        </div>
        <ul class="mt-7 flex flex-col gap-2.5 text-[0.9375rem] leading-snug text-white/80 lg:flex-row lg:flex-wrap lg:gap-x-6">
          {
            trust.map(({ icon: Icon, label }) => (
              <li class="flex items-center gap-2">
                <Icon size={18} aria-hidden="true" class="shrink-0 text-lilac" />
                {label}
              </li>
            ))
          }
        </ul>
      </div>
    </Container>
  </div>

  <div
    class:list={[
      'pointer-events-none absolute inset-x-0 top-0 z-20 lg:inset-y-0',
      mediaBox,
    ]}
  >
    <Container class="relative h-full">
      <div
        class="absolute inset-x-5 bottom-9 flex flex-col items-start gap-1 md:inset-x-8 lg:pointer-events-auto lg:inset-x-auto lg:right-8 lg:bottom-10 lg:w-[19rem] lg:items-stretch lg:gap-0 lg:rounded-card lg:border lg:border-white/15 lg:bg-violet-dark/70 lg:px-5 lg:pt-4 lg:pb-1 lg:backdrop-blur-md"
      >
        <div
          class="pointer-events-auto rounded-pill bg-violet-dark/75 px-4 py-2 backdrop-blur-md lg:rounded-none lg:bg-transparent lg:p-0 lg:backdrop-blur-none"
        >
          <p class="hidden text-[0.8125rem] leading-none font-semibold tracking-[0.14em] text-lilac-soft uppercase lg:block">
            Conocé con Molinari
          </p>
          <p
            class="font-display text-base leading-tight font-bold text-white motion-safe:transition-opacity motion-safe:duration-500 lg:mt-2 lg:text-[1.375rem]"
            data-hero-name
          >
            {first.destination}
          </p>
          <a
            href={first.href}
            class="mt-1 hidden min-h-12 items-center gap-1.5 font-semibold text-white underline-offset-4 hover:underline focus-visible:outline-white lg:inline-flex"
            data-hero-link
          >
            Ver viaje
            <span class="sr-only" data-hero-link-label>a {first.destination}</span>
            <ArrowRight size={18} aria-hidden="true" />
          </a>
        </div>

        <div class="hidden w-full items-center gap-3 group-data-ready/hero:flex">
          <div class="pointer-events-auto flex flex-1 gap-1.5" role="group" aria-label="Fotos de destinos">
            {
              slides.map((slide, i) => (
                <button
                  type="button"
                  class:list={[
                    'group/segment flex h-11 flex-1 cursor-pointer items-center focus-visible:outline-white',
                    i === 0 && 'is-active',
                  ]}
                  aria-label={`Ver foto de ${slide.destination}`}
                  aria-current={i === 0 ? 'true' : undefined}
                  data-segment
                >
                  <span class="relative block h-[3px] w-full overflow-hidden rounded-pill bg-white/35 group-hover/segment:bg-white/55">
                    <span class="hero-fill absolute inset-0 rounded-pill bg-white" data-fill />
                  </span>
                </button>
              ))
            }
          </div>
          <button
            type="button"
            class:list={[toggleClass, 'hidden lg:group-data-ready/hero:inline-flex']}
            aria-label="Pausar fotos"
            data-hero-toggle
          >
            <span data-icon-pause class="inline-flex"><Pause size={20} aria-hidden="true" /></span>
            <span data-icon-play class="inline-flex" hidden><Play size={20} aria-hidden="true" /></span>
          </button>
        </div>
      </div>

      <button
        type="button"
        class:list={[
          toggleClass,
          'absolute top-4 right-5 hidden group-data-ready/hero:inline-flex md:right-8 lg:hidden!',
        ]}
        aria-label="Pausar fotos"
        data-hero-toggle
      >
        <span data-icon-pause class="inline-flex"><Pause size={20} aria-hidden="true" /></span>
        <span data-icon-play class="inline-flex" hidden><Play size={20} aria-hidden="true" /></span>
      </button>
    </Container>
  </div>

  <p class="sr-only" aria-live="polite" data-hero-live></p>
</section>

<script>
  const hero = document.querySelector('[data-hero]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (hero instanceof HTMLElement) {
    const slides = [...hero.querySelectorAll('[data-slide]')];
    const segments = [...hero.querySelectorAll('[data-segment]')];
    const name = hero.querySelector('[data-hero-name]');
    const link = hero.querySelector('[data-hero-link]');
    const linkLabel = hero.querySelector('[data-hero-link-label]');
    const live = hero.querySelector('[data-hero-live]');
    const toggles = [...hero.querySelectorAll('[data-hero-toggle]')];
    const leaveTimers = new Map();
    let index = 0;
    let userPaused = false;

    hero.toggleAttribute('data-ready', true);

    function updatePaused() {
      hero.toggleAttribute('data-paused', userPaused || document.hidden);
    }

    function updateName(slide) {
      const destination = slide.dataset.destination ?? '';
      if (link instanceof HTMLAnchorElement) link.href = slide.dataset.href ?? '/paquetes';
      if (linkLabel) linkLabel.textContent = `a ${destination}`;
      if (!(name instanceof HTMLElement)) return;
      if (reduceMotion.matches) {
        name.textContent = destination;
        return;
      }
      name.classList.add('opacity-0');
      window.setTimeout(() => {
        name.textContent = destination;
        name.classList.remove('opacity-0');
      }, 500);
    }

    function show(next, fromUser) {
      if (next === index) return;
      const current = slides[index];
      const target = slides[next];
      const targetImg = target.querySelector('img');

      if (targetImg instanceof HTMLImageElement && !targetImg.complete) {
        targetImg.addEventListener('load', () => show(next, fromUser), { once: true });
        return;
      }

      const currentImg = current.querySelector('img');
      if (currentImg instanceof HTMLImageElement) {
        currentImg.style.scale = getComputedStyle(currentImg).scale;
      }
      current.classList.remove('is-active');
      current.classList.add('is-leaving');
      current.setAttribute('aria-hidden', 'true');
      window.clearTimeout(leaveTimers.get(current));
      leaveTimers.set(
        current,
        window.setTimeout(() => {
          current.classList.remove('is-leaving');
          currentImg?.style.removeProperty('scale');
        }, 1600),
      );

      window.clearTimeout(leaveTimers.get(target));
      target.classList.remove('is-leaving');
      targetImg?.style.removeProperty('scale');
      target.classList.add('is-active');
      target.removeAttribute('aria-hidden');

      segments.forEach((segment, i) => {
        segment.classList.toggle('is-active', i === next);
        segment.classList.toggle('is-done', i < next);
        if (i === next) segment.setAttribute('aria-current', 'true');
        else segment.removeAttribute('aria-current');
      });

      index = next;
      updateName(target);
      if (fromUser && live) live.textContent = `Foto de ${target.dataset.destination}`;
    }

    hero.addEventListener('animationend', (event) => {
      const fill = event.target;
      if (!(fill instanceof Element) || !fill.matches('[data-fill]')) return;
      if (fill.closest('[data-segment]') !== segments[index]) return;
      show((index + 1) % slides.length, false);
    });

    segments.forEach((segment, i) => {
      segment.addEventListener('click', () => show(i, true));
    });

    toggles.forEach((toggle) => {
      toggle.addEventListener('click', () => {
        userPaused = !userPaused;
        toggles.forEach((button) => {
          button.setAttribute('aria-label', userPaused ? 'Reanudar fotos' : 'Pausar fotos');
          const iconPause = button.querySelector('[data-icon-pause]');
          const iconPlay = button.querySelector('[data-icon-play]');
          if (iconPause instanceof HTMLElement) iconPause.hidden = userPaused;
          if (iconPlay instanceof HTMLElement) iconPlay.hidden = !userPaused;
        });
        updatePaused();
      });
    });

    document.addEventListener('visibilitychange', updatePaused);
    updatePaused();
  }
</script>
