---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import PackageCard from '../packages/PackageCard.astro';
import { getFeaturedPackages } from '../../data/packages.js';

const packages = getFeaturedPackages();
---

<section id="paquetes" class="scroll-mt-24 pt-18 pb-9 lg:pt-28 lg:pb-14" aria-label="Próximas salidas destacadas">
  <Container>
    <SectionHeading
      eyebrow="Salidas destacadas"
      title="Próximas salidas destacadas"
      subtitle="Viajes en grupo, con la coordinación de Molinari de principio a fin."
    />
    <ul class="mt-10 grid grid-cols-1 items-stretch gap-7 md:mt-12 md:grid-cols-2 md:gap-8 lg:grid-cols-3">
      {
        packages.map((pkg) => (
          <li class="h-full">
            <PackageCard pkg={pkg} />
          </li>
        ))
      }
    </ul>
    <div class="mt-10 flex justify-center md:mt-12">
      <Button href="/paquetes" variant="secondary" size="large">
        Ver todos los paquetes
      </Button>
    </div>
  </Container>
</section>
