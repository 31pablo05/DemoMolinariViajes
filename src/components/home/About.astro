---
import { Image } from 'astro:assets';
import { ArrowRight, Globe, MapPin, Users } from '@lucide/astro';
import Container from '../ui/Container.astro';
import { site } from '../../config/site.js';

const agencyImages = import.meta.glob('../../assets/images/agency/vidriera.webp', {
  eager: true,
  import: 'default',
});
const vidriera = Object.values(agencyImages)[0];
const photoAlt = 'Vidriera de Molinari Viajes en Belgrano 461, Trelew';
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Molinari Viajes, ${site.address}`)}`;

const highlights = [
  { label: 'Agencia de Trelew', icon: MapPin },
  { label: 'Atención cercana', icon: Users },
  { label: 'Experiencia en viajes internacionales', icon: Globe },
];
---

<section id="nosotros" class="scroll-mt-24 py-9 lg:py-14" aria-labelledby="nosotros-titulo">
  <Container>
    <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,11fr)_1px_minmax(0,9fr)] lg:gap-x-10">
      <div class="overflow-hidden rounded-card-lg shadow-rest">
        {
          vidriera ? (
            <Image
              src={vidriera}
              alt={photoAlt}
              width={960}
              height={640}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1024px) 55vw, 100vw"
              loading="lazy"
              class="aspect-[3/2] h-full w-full object-cover"
            />
          ) : (
            <div class="aspect-[3/2] bg-lilac-soft" role="img" aria-label={photoAlt} />
          )
        }
      </div>
      <div class="hidden h-full self-stretch bg-lilac lg:block" aria-hidden="true"></div>
      <div>
        <p class="font-body font-semibold tracking-wide text-violet uppercase">
          Nuestra agencia
        </p>
        <h2
          id="nosotros-titulo"
          class="mt-3 font-display text-3xl leading-tight font-bold text-violet-dark md:text-4xl"
        >
          Una agencia con historia y confianza
        </h2>
        <div class="mt-4 space-y-4">
          <p>
            Molinari Viajes es una agencia de viajes y turismo de Trelew. Trabajamos con atención
            personalizada, asesoramiento cercano y salidas acompañadas a destinos internacionales.
          </p>
          <p>
            Detrás de cada viaje hay personas que organizan, explican y acompañan: antes de salir,
            durante el recorrido y al volver.
          </p>
        </div>
        <ul class="mt-6 grid gap-3 sm:grid-cols-3">
          {
            highlights.map(({ label, icon: Icon }) => (
              <li class="flex min-w-0 items-center gap-3 rounded-card bg-lilac-soft px-3 py-3">
                <Icon size={24} aria-hidden="true" class="size-6 shrink-0 text-violet" />
                <span class="min-w-0 text-base leading-tight font-semibold text-violet-dark">{label}</span>
              </li>
            ))
          }
        </ul>
        <a
          href={mapsUrl}
          class="mt-6 inline-flex min-h-12 items-center gap-2 text-lg font-semibold text-violet no-underline hover:text-violet-dark"
          target="_blank"
          rel="noopener noreferrer"
        >
          Visitanos en Belgrano 461
          <ArrowRight size={20} aria-hidden="true" class="size-5 shrink-0" />
          <span class="sr-only"> (se abre en una ventana nueva)</span>
        </a>
      </div>
    </div>
  </Container>
</section>
