---
import { Image } from 'astro:assets';
import { CircleCheck, MapPin } from '@lucide/astro';
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import vidriera from '../../assets/images/agency/vidriera.webp';
import { site } from '../../config/site.js';
import { getGeneralWhatsAppLink } from '../../lib/whatsapp.js';

const photoAlt = 'Vidriera de Molinari Viajes en Belgrano 461, Trelew, con afiches de viajes y el logo de la agencia.';
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`Molinari Viajes, ${site.address}`)}`;
const [street, ...cityParts] = site.address.split(',').map((part) => part.trim());
const city = cityParts.join(', ');

const highlights = [
  'Agencia local con oficina a la calle',
  'Te atendemos en persona y por WhatsApp',
  'Coordinación de salidas grupales al exterior',
];
---

<section id="nosotros" class="scroll-mt-24 bg-cream py-18 lg:py-28" aria-labelledby="nosotros-titulo">
  <Container>
    <div class="grid items-center gap-14 lg:grid-cols-2 lg:gap-16 xl:gap-20">
      <div class="relative lg:mr-5 lg:mb-5">
        <div
          class="absolute inset-0 hidden translate-x-5 translate-y-5 rounded-3xl bg-lilac lg:block"
          aria-hidden="true"
        >
        </div>
        <div class="relative overflow-hidden rounded-3xl shadow-hover lg:-rotate-[1.5deg]">
          <Image
            src={vidriera}
            alt={photoAlt}
            width={680}
            height={510}
            widths={[480, 680]}
            sizes="(min-width: 1024px) 560px, 100vw"
            loading="lazy"
            class="aspect-[4/3] h-full w-full object-cover"
          />
        </div>
        <div
          class="absolute right-4 -bottom-8 flex items-center gap-3 rounded-card bg-white py-3 pr-5 pl-3 shadow-hover sm:right-6 lg:-right-4 lg:bottom-8"
        >
          <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-full bg-lilac-soft">
            <MapPin size={22} aria-hidden="true" class="text-violet" />
          </span>
          <p class="text-base leading-tight">
            <span class="block font-bold text-violet-dark">{street}</span>
            <span class="block text-muted">{city}</span>
          </p>
        </div>
      </div>

      <div>
        <SectionHeading
          id="nosotros-titulo"
          eyebrow="Nuestra agencia"
          title="Una agencia con historia y confianza"
        />
        <div class="mt-6 space-y-4">
          <p>
            Molinari Viajes es una agencia de viajes y turismo de Trelew. Trabajamos con atención
            personalizada, asesoramiento cercano y salidas acompañadas a destinos internacionales.
          </p>
          <p>
            Detrás de cada viaje hay personas que organizan, explican y acompañan: antes de salir,
            durante el recorrido y al volver.
          </p>
        </div>
        <ul class="mt-7 space-y-3">
          {
            highlights.map((label) => (
              <li class="flex items-start gap-3 text-[1.0625rem] leading-snug text-violet-dark md:text-lg">
                <CircleCheck size={24} aria-hidden="true" class="mt-px size-6 shrink-0 text-violet" />
                <span>{label}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <Button href={mapsUrl} variant="secondary" size="large" icon={MapPin} class="w-full sm:w-auto">
            Cómo llegar
          </Button>
          <Button href={getGeneralWhatsAppLink()} variant="whatsapp" size="large" class="w-full sm:w-auto">
            Escribinos
          </Button>
        </div>
      </div>
    </div>
  </Container>
</section>
