---
import Eyebrow from './Eyebrow.astro';

const { eyebrow, title, subtitle, align = 'start', tone = 'default', id, class: className } = Astro.props;
const centered = align === 'center';
const light = tone === 'light';
---

<div class:list={[centered && 'text-center', className]}>
  {
    eyebrow && (
      <Eyebrow tone={tone} class:list={['mb-4', centered && 'justify-center']}>
        {eyebrow}
      </Eyebrow>
    )
  }
  <h2
    id={id}
    class:list={[
      'font-display text-[2rem] leading-[1.1] font-extrabold tracking-[-0.02em] text-balance md:text-[2.5rem] lg:text-5xl',
      light ? 'text-white' : 'text-violet-dark',
    ]}
  >
    {title}
  </h2>
  {
    subtitle && (
      <p
        class:list={[
          'mt-4 max-w-[60ch]',
          light ? 'text-lilac-soft' : 'text-muted',
          centered && 'mx-auto',
        ]}
      >
        {subtitle}
      </p>
    )
  }
</div>
