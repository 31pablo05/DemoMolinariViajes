---
const { variant = 'default', class: className } = Astro.props;

const variants = {
  default: 'bg-violet-dark text-white',
  demo: 'bg-lilac-soft text-violet',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-pill px-3 py-1.5 font-body text-base font-semibold leading-none',
    variants[variant] ?? variants.default,
    className,
  ]}
>
  <slot />
</span>
