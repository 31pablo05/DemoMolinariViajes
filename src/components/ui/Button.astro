---
import { ArrowRight } from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';

const {
  href,
  variant = 'primary',
  size = 'normal',
  icon: Icon,
  arrow = variant === 'primary',
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const isLink = typeof href === 'string';
const isExternal = isLink && /^https?:\/\//i.test(href);
const isWhatsApp = variant === 'whatsapp' || variant === 'whatsapp-outline';
const iconSize = size === 'large' ? 22 : 20;

const variants = {
  primary:
    'border border-transparent bg-violet text-white shadow-violet hover:bg-violet-dark hover:shadow-hover active:shadow-violet',
  secondary:
    'border border-violet bg-white text-violet shadow-rest hover:border-violet-dark hover:bg-lilac-soft hover:text-violet-dark hover:shadow-hover active:shadow-rest',
  whatsapp:
    'border border-transparent bg-whatsapp text-white shadow-whatsapp hover:bg-whatsapp-hover hover:shadow-hover active:shadow-whatsapp',
  'whatsapp-outline':
    'border border-whatsapp bg-white text-whatsapp shadow-rest hover:border-whatsapp-hover hover:text-whatsapp-hover hover:shadow-hover active:shadow-rest',
  'ghost-light':
    'border border-white bg-transparent text-white hover:bg-white/15 hover:shadow-hover focus-visible:outline-white',
};

const sizes = {
  normal: 'min-h-13 min-w-12 gap-2 px-6 text-base',
  large: 'min-h-15 min-w-12 gap-2.5 px-8 text-lg',
};

const classes = [
  'group/button inline-flex cursor-pointer items-center justify-center rounded-pill text-center font-body font-semibold leading-tight no-underline motion-safe:transition motion-safe:duration-200',
  'motion-safe:hover:-translate-y-px motion-safe:active:translate-y-0',
  variants[variant] ?? variants.primary,
  sizes[size] ?? sizes.normal,
  className,
];
const arrowClass =
  'shrink-0 motion-safe:transition-transform motion-safe:duration-200 motion-safe:group-hover/button:translate-x-[3px]';
---

{
  isLink ? (
    <a
      href={href}
      class:list={classes}
      {...rest}
      {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
    >
      {isWhatsApp ? (
        <WhatsAppIcon size={iconSize} />
      ) : (
        Icon && <Icon size={iconSize} aria-hidden="true" class="shrink-0" />
      )}
      <slot />
      {arrow && <ArrowRight size={iconSize} aria-hidden="true" class={arrowClass} />}
      {isExternal && <span class="sr-only"> (se abre en una ventana nueva)</span>}
    </a>
  ) : (
    <button type={type} class:list={classes} {...rest}>
      {isWhatsApp ? (
        <WhatsAppIcon size={iconSize} />
      ) : (
        Icon && <Icon size={iconSize} aria-hidden="true" class="shrink-0" />
      )}
      <slot />
      {arrow && <ArrowRight size={iconSize} aria-hidden="true" class={arrowClass} />}
    </button>
  )
}
