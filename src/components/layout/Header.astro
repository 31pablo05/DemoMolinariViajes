---
import { Image } from 'astro:assets';
import { Menu, X } from '@lucide/astro';
import Button from '../ui/Button.astro';
import logo from '../../assets/images/brand/logo-horizontal.png';
import logoMark from '../../assets/images/brand/logo-wordmark.png';
import { site } from '../../config/site.js';
import { getGeneralWhatsAppLink } from '../../lib/whatsapp.js';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/';
const whatsappHref = getGeneralWhatsAppLink();

const links = [
  { label: 'Inicio', href: '/', current: isHome },
  {
    label: 'Paquetes',
    href: '/paquetes',
    current: path === '/paquetes' || path.startsWith('/paquetes/'),
  },
  { label: 'Nosotros', href: isHome ? '#nosotros' : '/#nosotros', current: false },
  {
    label: 'Experiencias',
    href: isHome ? '#experiencias' : '/#experiencias',
    current: false,
  },
  {
    label: 'Contacto',
    href: '/contacto',
    current: path === '/contacto' || path.startsWith('/contacto/'),
  },
];
---

<header class="group/header sticky top-0 z-40" data-site-header>
  <div
    class="absolute inset-0 -z-10 border-b border-violet/8 bg-white/92 backdrop-blur-md motion-safe:transition-shadow motion-safe:duration-300 motion-safe:ease-out group-data-scrolled/header:shadow-[0_6px_20px_color-mix(in_srgb,var(--color-violet-dark)_7%,transparent)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="mx-auto flex h-21 max-w-page items-center justify-between gap-4 px-5 motion-safe:transition-[height] motion-safe:duration-300 motion-safe:ease-out group-data-scrolled/header:h-17 md:px-8 lg:grid lg:grid-cols-[auto_minmax(0,1fr)_auto] lg:gap-x-8"
  >
    <a href="/" class="inline-flex min-h-12 shrink-0 items-center rounded-card">
      <Image
        src={logo}
        alt="Molinari Viajes, inicio"
        width={237}
        height={52}
        densities={[2]}
        loading="eager"
        class="h-10 w-auto lg:hidden"
      />
      <span
        class="relative hidden w-fit motion-safe:transition-[height,font-size] motion-safe:duration-300 motion-safe:ease-out lg:block lg:h-14 lg:text-[3.5rem] lg:group-data-scrolled/header:h-[46px] lg:group-data-scrolled/header:text-[46px]"
      >
        <Image
          src={logoMark}
          alt="Molinari Viajes, agencia de turismo, inicio"
          width={551}
          height={149}
          densities={[2]}
          loading="eager"
          class="h-full w-auto"
        />
        <span
          class="absolute top-[58%] right-0 left-[31.2%] flex items-center justify-center gap-[0.28em] font-body text-[0.18em] leading-none font-semibold tracking-[0.04em] text-violet uppercase"
          aria-hidden="true"
        >
          <span class="h-px w-[0.7em] shrink-0 bg-current"></span>
          Agencia de turismo
          <span class="h-px w-[0.7em] shrink-0 bg-current"></span>
        </span>
      </span>
    </a>

    <nav class="hidden lg:flex lg:items-center lg:justify-center lg:gap-x-4 xl:gap-x-6" aria-label="Principal">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="group/link relative inline-flex min-h-12 items-center px-3.5 font-body text-base font-semibold text-violet-dark"
            {...(link.current ? { 'aria-current': 'page' } : {})}
          >
            {link.label}
            <span
              class:list={[
                'absolute inset-x-3.5 bottom-1.5 h-0.5 origin-center rounded-pill bg-violet motion-safe:transition-transform motion-safe:duration-200',
                link.current
                  ? 'scale-x-100'
                  : 'scale-x-0 group-hover/link:scale-x-100 group-focus-visible/link:scale-x-100',
              ]}
              aria-hidden="true"
            >
            </span>
          </a>
        ))
      }
    </nav>

    <div class="flex items-center">
      <div class="hidden lg:block">
        <Button
          href={whatsappHref}
          variant="whatsapp"
          class="h-[46px]! min-h-[46px]! shrink-0 shadow-none! hover:shadow-none! active:shadow-none!"
        >
          <span class="xl:hidden">WhatsApp</span>
          <span class="hidden xl:inline">Consultanos por WhatsApp</span>
        </Button>
      </div>
      <button
        type="button"
        class="inline-flex size-12 items-center justify-center rounded-pill text-violet-dark lg:hidden"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
      >
        <span class="sr-only" data-menu-label>Abrir menú</span>
        <span data-icon-open class="inline-flex">
          <Menu size={28} aria-hidden="true" />
        </span>
        <span data-icon-close class="inline-flex" hidden>
          <X size={28} aria-hidden="true" />
        </span>
      </button>
    </div>
  </div>

  <button
    type="button"
    class="fixed inset-x-0 bottom-0 z-20 bg-violet-dark/40 opacity-0 transition-opacity duration-[220ms] ease-out motion-reduce:transition-none top-(--menu-top) group-data-open/header:opacity-100 lg:hidden"
    data-menu-veil
    tabindex="-1"
    aria-label="Cerrar menú"
    hidden
  >
  </button>

  <div
    id="menu-movil"
    class="absolute inset-x-0 top-full z-30 grid grid-rows-[0fr] transition-[grid-template-rows] duration-[220ms] ease-out motion-reduce:transition-none group-data-open/header:grid-rows-[1fr] lg:hidden"
    data-menu-panel
    hidden
  >
    <div class="min-h-0 overflow-hidden">
      <div class="pb-8">
        <div class="rounded-b-card-lg bg-white shadow-rest">
          <nav aria-label="Principal">
            <ul>
              {
                links.map((link) => (
                  <li class="border-b border-lilac-soft last:border-b-0">
                    <a
                      href={link.href}
                      class:list={[
                        'flex min-h-12 items-center px-5 font-body text-lg font-semibold md:px-8',
                        link.current ? 'text-violet' : 'text-violet-dark',
                      ]}
                      {...(link.current ? { 'aria-current': 'page' } : {})}
                    >
                      <span class:list={[link.current && 'border-b-2 border-violet pb-0.5']}>
                        {link.label}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
          </nav>
          <div class="px-5 pt-4 pb-4 md:px-8">
            <Button href={whatsappHref} variant="whatsapp" class="w-full">
              Consultanos por WhatsApp
            </Button>
            <p class="mt-3 text-center text-sm leading-snug whitespace-nowrap text-muted">
              {site.address}
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector('[data-site-header]');
  const toggle = header?.querySelector('[data-menu-toggle]');
  const panel = header?.querySelector('[data-menu-panel]');
  const veil = header?.querySelector('[data-menu-veil]');
  const iconOpen = header?.querySelector('[data-icon-open]');
  const iconClose = header?.querySelector('[data-icon-close]');
  const label = header?.querySelector('[data-menu-label]');
  const desktop = window.matchMedia('(min-width: 1024px)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let closeTimer = 0;

  function updateScrolled() {
    header?.toggleAttribute('data-scrolled', window.scrollY > 40);
  }

  updateScrolled();
  window.addEventListener('scroll', updateScrolled, { passive: true });

  function finishClose() {
    if (!(header instanceof HTMLElement) || header.hasAttribute('data-open')) return;
    if (panel instanceof HTMLElement) panel.hidden = true;
    if (veil instanceof HTMLElement) veil.hidden = true;
  }

  function setOpen(open) {
    if (!(header instanceof HTMLElement)) return;
    if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) return;
    if (!(veil instanceof HTMLElement)) return;
    if (!(iconOpen instanceof HTMLElement) || !(iconClose instanceof HTMLElement)) return;

    window.clearTimeout(closeTimer);

    if (open) {
      header.style.setProperty('--menu-top', `${header.getBoundingClientRect().bottom}px`);
      veil.hidden = false;
      panel.hidden = false;
      if (reduceMotion.matches) {
        header.setAttribute('data-open', '');
      } else {
        requestAnimationFrame(() => {
          requestAnimationFrame(() => header.setAttribute('data-open', ''));
        });
      }
    } else {
      header.removeAttribute('data-open');
      if (reduceMotion.matches) {
        finishClose();
      } else {
        panel.addEventListener(
          'transitionend',
          (event) => {
            if (event.target !== panel || event.propertyName !== 'grid-template-rows') return;
            finishClose();
          },
          { once: true },
        );
        closeTimer = window.setTimeout(finishClose, 280);
      }
    }

    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    const text = open ? 'Cerrar menú' : 'Abrir menú';
    toggle.setAttribute('aria-label', text);
    if (label) label.textContent = text;
    iconOpen.hidden = open;
    iconClose.hidden = !open;
    document.documentElement.classList.toggle('overflow-hidden', open);
  }

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  veil?.addEventListener('click', () => setOpen(false));

  panel?.addEventListener('click', (event) => {
    const target = event.target;
    if (target instanceof Element && target.closest('a')) setOpen(false);
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || toggle?.getAttribute('aria-expanded') !== 'true') return;
    setOpen(false);
    if (toggle instanceof HTMLButtonElement) toggle.focus();
  });

  desktop.addEventListener('change', (event) => {
    if (event.matches) setOpen(false);
  });
</script>
